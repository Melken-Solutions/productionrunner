# Template only. Never commit real credentials. Configure these in the host dashboard.
PR_ENV=production
PR_DATA_DIR=/var/data/productionrunner
# Generate a random secret (at least 32 characters) in the hosting secret manager.
PR_SECRET_KEY=
PR_HTTPS=1
# Exact hostnames, comma-separated, no scheme/port/wildcard.
PR_TRUSTED_HOSTS=pilot.example.com
# 0.0.0.0 only inside a host platform that routes requests through HTTPS ingress.
PR_BIND_HOST=0.0.0.0
PORT=8080

# PostgreSQL staging: use a dedicated runtime login, never the migration owner.
# Configure privately with sslmode=verify-full and the provider root certificate.
# PR_DATABASE_URL=
# Canonical HTTPS origin for invitations (must match PR_TRUSTED_HOSTS).
# PR_PUBLIC_ORIGIN=https://pilot.example.com

# Cloud PDF/DXF storage; secrets are server-only. SQLite local mode uses database bytes.
# PR_FILE_STORAGE=supabase
# PR_SUPABASE_URL=https://PROJECT_REF.supabase.co
# PR_STORAGE_BUCKET=productionrunner-files
# PR_SUPABASE_SECRET_KEY=
