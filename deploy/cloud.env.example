# Template only. Never commit real credentials. Configure these in the host dashboard.
PR_ENV=production
PR_DATA_DIR=/var/data/productionrunner
# Generate a random secret (at least 32 characters) in the hosting secret manager.
PR_SECRET_KEY=
PR_HTTPS=1
# Exact hostnames, comma-separated, no scheme/port/wildcard.
PR_TRUSTED_HOSTS=pilot.example.com
# 0.0.0.0 only inside a host platform that routes requests through HTTPS ingress.
PR_BIND_HOST=0.0.0.0
PORT=8080
